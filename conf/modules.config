/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'SYLPH_PROFILE' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/sylph" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/merged_fastq" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'SYLPH_ANNOTATE|BLAST_FORMAT' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/annotation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ASV_TOFASTA' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/asv" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BLAST_BLASTN' {
        // all-hit table: the formatter keeps the best-scoring hit(s) per ASV
        ext.args = '-max_target_seqs 500 -outfmt "6 qseqid staxids saccver stitle qlen length nident pident bitscore evalue score"'
        publishDir = [
            path: { "${params.outdir}/preprocessing/blast" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MICOM_TAXONOMY' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/taxonomy" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MICOM_GROW' {
        // A failed first attempt (no solution) is retried once with a higher Gurobi NumericFocus
        errorStrategy = 'retry'
        maxRetries    = 1
        ext.args = {
            def numeric_focus = task.attempt > 1 ? params.micom_numeric_focus_retry : params.micom_numeric_focus
            [
                "--solver ${params.micom_solver}",
                "--tradeoff ${params.micom_tradeoff}",
                "--cutoff ${params.micom_cutoff}",
                "--tolerance ${params.micom_tolerance}",
                params.micom_presolve != null ? "--presolve ${params.micom_presolve}" : '',
                numeric_focus != null ? "--numeric-focus ${numeric_focus}" : '',
                params.micom_coupling ? '' : '--no-coupling',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/growth" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MICOM_MERGE' {
        ext.prefix = { params.name }
        ext.args = { params.umap_n_neighbors ? "--n-neighbors ${params.umap_n_neighbors}" : '' }
        publishDir = [
            path: { "${params.outdir}/merged" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
