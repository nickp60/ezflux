/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reads from the nf-core/funcprofiler (taxprofiler) test samplesheet: integer sample IDs, two
    runs per sample (merged with cat/fastq), then sylph + the AGORA2 species-level models.

    The databases are NOT part of the pipeline: put (or link) these files in the launch directory
        agora2.syldb                              sylph database of the AGORA2 genomes
        agora2.metadata.csv                       Genome_file -> taxonomy, shipped with the model DB
        agora201_refseq216_species_1.qza          micom model database
    or override --sylph_db / --model_metadata / --micom_db. The medium (western diet) is downloaded.

    Use as follows:
        nextflow run nf-core/ezflux -profile test,<docker/singularity> --outdir <OUTDIR>
    For a run that needs no downloads or licenses, see the `test_local` profile.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input          = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/funcprofiler/samplesheets/test_full.csv'
    sylph_db       = 'agora2.syldb'
    model_metadata = 'agora2.metadata.csv'
    micom_db       = 'agora201_refseq216_species_1.qza'
    // no --media: every sample grows on the default --medium (western diet, from Zenodo)
}
