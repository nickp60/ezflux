/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Self-contained test: a wide ASV table with two samples (blastn against a toy 16S database) on two
    diets, a 3-species toy micom database, and the open-source solver (no license needed).

    Use as follows (from the pipeline root, sample sheet paths are relative to the launch dir):
        nextflow run nf-core/ezflux -profile test_local,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Local test profile'
    config_profile_description = 'Bundled toy data: ASV tables, BLAST 16S database, toy micom database'

    seqtab_input   = "${projectDir}/assets/test_data/seqtab.csv"
    media          = "${projectDir}/assets/test_data/media.csv"
    micom_db       = "${projectDir}/assets/test_data/micom_db.qza"
    model_metadata = "${projectDir}/assets/test_data/model_metadata.tsv"
    blast_db       = "${projectDir}/assets/test_data/blast_db"

    // osqp needs no license (use gurobi/cplex for real data)
    micom_solver = 'osqp'
}
