nextflow_workflow {

    name "Test MICOM_GROW"
    script "./wrappers.nf"
    workflow "TEST_MICOM_GROW"
    tag "modules_local"
    tag "micom_grow"

    // growth_rates.csv inside the zip written by save_results
    def growthRates = { zipPath ->
        def zip = new java.util.zip.ZipFile(zipPath.toString())
        try {
            def lines = zip.getInputStream(zip.getEntry("growth_rates.csv")).text.readLines()
            def header = lines[0].split(',') as List
            return lines.drop(1).collect { line -> [header, line.split(',') as List].transpose().collectEntries() }
        } finally {
            zip.close()
        }
    }

    def inputs = """
        input[0] = 'sample_1'
        input[1] = 'diet'
        input[2] = file("\${projectDir}/tests/data/grow/taxonomy.csv")
        input[3] = file("\${projectDir}/tests/data/grow/medium.qza")
        input[4] = file("\${projectDir}/tests/data/grow/strain_models.qza")
        """

    test("one sample on one diet; results are labelled <sample>__<medium>") {
        when {
            workflow { inputs }
        }
        then {
            def rows = growthRates(workflow.out.zip[0])
            assertAll(
                { assert workflow.success },
                { assert rows.size() == 4 },
                { assert rows.every { row -> row.sample_id == 'sample_1__diet' } },
                { assert rows.every { row -> row.growth_rate.toDouble() > 0 } },
                { assert new File(workflow.out.build_manifest[0].toString()).readLines()[0].contains('found_abundance_fraction') }
            )
        }
    }

    test("the built community models are an output, and the build manifest is printed before the growth run") {
        when {
            workflow { inputs }
        }
        then {
            def models = new File(workflow.out.models[0].toString())
            def pickles = models.listFiles().collect { f -> f.name }
            // task stdout of the (single) task
            def stdout = new File(workflow.out.models[0].toString()).parentFile.toPath().resolve('.command.out').toFile()
            assertAll(
                { assert workflow.success },
                { assert models.isDirectory() && models.name == 'sample_1__diet.models' },
                { assert pickles.contains('sample_1.pickle') },
                { assert pickles.contains('manifest.csv') },
                { assert stdout.text.contains('Build manifest:') && stdout.text.contains('found_abundance_fraction') }
            )
        }
    }

    test("Gurobi barrier options are passed on to the script (and ignored by other solvers)") {
        when {
            params {
                micom_bar_conv_tol   = 1e-8
                micom_bar_iter_limit = 3500
                micom_solver_log     = true
            }
            workflow { inputs }
        }
        then {
            def command = new File(workflow.out.models[0].toString()).parentFile.toPath().resolve('.command.sh').toFile().text
            assertAll(
                { assert workflow.success },
                { assert (command =~ /--bar-conv-tol (\S+)/)[0][1].toDouble() == 1e-8 },
                { assert command.contains('--bar-iter-limit 3500') },
                { assert command.contains('--solver-log') }
            )
        }
    }

    test("collapse_rare_bugs pools the taxa between micom_cutoff and rare_bugs_threshold into one 'rare' organism") {
        // relative abundances: strain_a 0.331, strain_c 0.305, strain_b 0.271, strain_d 0.093 -> b and d are collapsed
        when {
            params {
                collapse_rare_bugs  = true
                rare_bugs_threshold = 0.3
            }
            workflow { inputs }
        }
        then {
            def rows = growthRates(workflow.out.zip[0])
            def taxa = rows.collect { row -> row.taxon }.sort()
            def taskDir = new File(workflow.out.models[0].toString()).parentFile
            def collapsed = new File(taskDir, 'sample_1__diet.collapsed_taxa.csv').readLines()
            def manifest = new File(workflow.out.build_manifest[0].toString()).readLines()
            assertAll(
                { assert workflow.success },
                { assert taxa == [ 'rare', 'strain_a', 'strain_c' ] },
                { assert rows.every { row -> row.growth_rate.toDouble() > 0 } },
                { assert (rows.find { row -> row.taxon == 'rare' }.abundance.toDouble() - 0.36412).abs() < 1e-4 },
                { assert collapsed.size() == 3 && collapsed.drop(1).collect { l -> l.split(',')[0] }.sort() == [ 'strain_b', 'strain_d' ] },
                { assert manifest[0].contains('n_collapsed_taxa') && manifest[0].contains('found_abundance_fraction') },
                { assert manifest[1].split(',')[manifest[0].split(',').toList().indexOf('n_collapsed_taxa')] == '2' },
                { assert new File(workflow.out.models[0].toString(), 'manifest.csv').text.contains('n_collapsed_taxa') }
            )
        }
    }

    test("collapse_rare_bugs with fewer than two rare taxa builds the sample as usual") {
        when {
            params {
                collapse_rare_bugs  = true
                rare_bugs_threshold = 0.1    // only strain_d (0.093) is rare
            }
            workflow { inputs }
        }
        then {
            def rows = growthRates(workflow.out.zip[0])
            assertAll(
                { assert workflow.success },
                { assert rows.collect { row -> row.taxon }.sort() == [ 'strain_a', 'strain_b', 'strain_c', 'strain_d' ] }
            )
        }
    }

    test("collapse_rare_bugs: a threshold that is not above micom_cutoff makes the task fail") {
        when {
            params {
                collapse_rare_bugs  = true
                rare_bugs_threshold = 0.0005
            }
            workflow { inputs }
        }
        then {
            assert workflow.failed
        }
    }

    test("fails (after the retry) when the sample cannot be solved") {
        // an unknown solver makes every attempt fail
        when {
            params {
                micom_solver = 'not_a_solver'
            }
            workflow { inputs }
        }
        then {
            assert workflow.failed
        }
    }

    test("a taxonomy with several samples is rejected") {
        when {
            workflow {
                """
                input[0] = 'sample_1'
                input[1] = 'diet'
                input[2] = file("\${projectDir}/tests/data/grow/taxonomy_two_samples.csv")
                input[3] = file("\${projectDir}/tests/data/grow/medium.qza")
                input[4] = file("\${projectDir}/tests/data/grow/strain_models.qza")
                """
            }
        }
        then {
            assert workflow.failed
        }
    }
}
