nextflow_workflow {

    name "Test SYLPH_ANNOTATE"
    script "./wrappers.nf"
    workflow "TEST_SYLPH_ANNOTATE"
    tag "modules_local"
    tag "sylph_annotate"

    test("raw sylph output is re-annotated with the model metadata (integer sample id)") {
        when {
            workflow {
                """
                input[0] = '2612'
                input[1] = file("\${projectDir}/assets/test_data/sylph_profile.tsv")
                input[2] = file("\${projectDir}/assets/test_data/model_metadata.tsv")
                """
            }
        }
        then {
            def lines = new File(workflow.out.abundances[0].toString()).readLines()
            assertAll(
                { assert workflow.success },
                { assert lines[0] == 'placeholder,sample_id,species,abundance' },
                // the archaeon is dropped; 60 : 30 -> 2/3 : 1/3, sorted by abundance
                { assert lines.size() == 3 },
                { assert lines[1].startsWith('a,2612,Escherichia coli,0.6666') },
                { assert lines[2].startsWith('a,2612,Escherichia fergusonii,0.3333') }
            )
        }
    }
}
